{
  "name": "swifty-codegen",
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "scripts": {
    "format:client": "pnpm --filter @swifty-codegen/client format",
    "format:server": "pnpm --filter @swifty-codegen/server format",
    "format": "concurrently \"pnpm format:client\" \"pnpm format:server\"",
    "dev:client": "pnpm --filter @swifty-codegen/client dev",
    "dev:server": "pnpm --filter @swifty-codegen/server dev",
    "dev": "concurrently \"pnpm dev:client\" \"pnpm dev:server\"",
    "build:client": "pnpm --filter @swifty-codegen/client build",
    "build:server": "pnpm --filter @swifty-codegen/server build",
    "build": "concurrently \"pnpm build:client\" \"pnpm build:server\"",
    "lint:client": "pnpm --filter @swifty-codegen/client lint",
    "lint:server": "pnpm --filter @swifty-codegen/server check",
    "lint": "concurrently \"pnpm lint:client\" \"pnpm check:server\"",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:push": "pnpm git:commit && git push origin main"
  }
}
