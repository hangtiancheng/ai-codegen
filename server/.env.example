# Runtime environment. Use `development`, `test`, or `production`.
NODE_ENV=development

# HTTP port used by the Hono server.
PORT=3000

# Public API prefix mounted by the server, for example `/api`.
API_PREFIX=api

# Application log level. Supported values: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://root:pass@localhost:5432/ai_codegen

# Redis connection string used for sessions, queues, and rate limiting.
REDIS_URL=redis://localhost:6379

# Comma-separated list of browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum accepted HTTP request body size in bytes.
REQUEST_BODY_LIMIT_BYTES=1048576

# Maximum user prompt length accepted by AI generation endpoints.
AI_PROMPT_MAX_LENGTH=4096

# Salt used for password hashing. Override this with a private random value.
PASSWORD_SALT=ai_codegen

# Secret used to sign sessions. Use at least 32 bytes of random data.
SESSION_SECRET=ai_codegen123456

# Enables the model health probe in the health-check endpoint.
HEALTH_MODEL_PROBE_ENABLED=true

# Maximum time in milliseconds allowed for the model health probe.
HEALTH_MODEL_TIMEOUT_MS=5000

# Maximum number of AI generation requests allowed per rate-limit window.
RATE_LIMIT_AI_GENERATION_MAX=10

# Rate-limit window length in seconds for AI generation requests.
RATE_LIMIT_AI_GENERATION_WINDOW_SECONDS=60

# Chromium executable path used by screenshot capture.
SCREENSHOT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# Maximum screenshot capture time in milliseconds.
SCREENSHOT_TIMEOUT_MS=30000

# Screenshot viewport width in pixels.
SCREENSHOT_VIEWPORT_WIDTH=1280

# Screenshot viewport height in pixels.
SCREENSHOT_VIEWPORT_HEIGHT=720

# Base URL of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Provider for route classification. Only `ollama` is supported.
AI_ROUTE_PROVIDER=ollama

# Ollama model used to classify the code generation type.
AI_ROUTE_MODEL=qwen2.5

# Maximum output tokens for route classification.
AI_ROUTE_MAX_TOKENS=100

# Sampling temperature for route classification.
AI_ROUTE_TEMPERATURE=0

# Provider for streaming code generation. Only `ollama` is supported.
AI_STREAMING_PROVIDER=ollama

# Ollama model used for streaming code generation.
AI_STREAMING_MODEL=qwen3.5

# Maximum output tokens for streaming code generation.
AI_STREAMING_MAX_TOKENS=65536

# Sampling temperature for streaming code generation.
AI_STREAMING_TEMPERATURE=0.2

# Provider for reasoning and prompt enhancement. Only `ollama` is supported.
AI_REASONING_PROVIDER=ollama

# Ollama model used for reasoning and prompt enhancement.
AI_REASONING_MODEL=qwen2.5

# Maximum output tokens for reasoning and prompt enhancement.
AI_REASONING_MAX_TOKENS=8192

# Sampling temperature for reasoning and prompt enhancement.
AI_REASONING_TEMPERATURE=0.1

# Provider for code quality checks. Only `ollama` is supported.
AI_QUALITY_PROVIDER=ollama

# Ollama model used for code quality checks.
AI_QUALITY_MODEL=qwen2.5

# Maximum output tokens for code quality checks.
AI_QUALITY_MAX_TOKENS=4096

# Sampling temperature for code quality checks.
AI_QUALITY_TEMPERATURE=0.2

# Public API host used to build deployed project URLs.
CODEGEN_DEPLOY_HOST=http://localhost:8123/api

# Storage backend for generated assets. Supported values: local, minio.
STORAGE_DRIVER=local

# Local filesystem directory used when STORAGE_DRIVER is `local`.
STORAGE_LOCAL_ROOT_DIR=tmp/storage

# Public base URL for files served from local storage.
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8123/storage

# MinIO endpoint host used when STORAGE_DRIVER is `minio`.
STORAGE_MINIO_ENDPOINT=localhost

# MinIO endpoint port.
STORAGE_MINIO_PORT=9000

# Whether to connect to MinIO over HTTPS.
STORAGE_MINIO_USE_SSL=false

# MinIO access key used when STORAGE_DRIVER is `minio`.
STORAGE_MINIO_ACCESS_KEY=<minio_access_key>

# MinIO secret key used when STORAGE_DRIVER is `minio`.
STORAGE_MINIO_SECRET_KEY=<minio_secret_key>

# MinIO bucket used to store generated assets.
STORAGE_MINIO_BUCKET=swifty-codegen

# Public base URL for files served from the MinIO bucket.
STORAGE_MINIO_PUBLIC_BASE_URL=http://localhost:9000/swifty-codegen
