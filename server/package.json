{
  "name": "@swifty-codegen/server",
  "version": "0.0.0",
  "description": "Hono backend for AI code generation.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm prisma:generate && rollup -c ./rollup.config.js",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "typecheck": "tsc -b --noEmit",
    "check": "biome check --write .",
    "check:ci": "biome check --reporter=github .",
    "ci": "pnpm prisma:validate && pnpm build && pnpm test && pnpm check:ci",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.7.6",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.2",
    "@langchain/ollama": "^1.2.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "archiver": "^7.0.1",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "ioredis": "^5.11.1",
    "langchain": "^1.4.4",
    "marked": "^17.0.6",
    "minio": "^8.0.7",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.61.1",
    "@faker-js/faker": "^10.4.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.19.42",
    "@types/pg": "^8.20.0",
    "msw": "^2.14.6",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "private": true
}
